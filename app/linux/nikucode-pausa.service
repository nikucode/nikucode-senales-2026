[Unit]
Description=nikucode pausas locales para Omarchy
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/lib/nikucode-pausa/nikucode_senales --daemon
WorkingDirectory=%h/.local/lib/nikucode-pausa
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
